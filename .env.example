# Copy to .env (never commit .env). The game reads these at build time via
# tools/write_config.py, which generates res://config/backend.json (git-ignored).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The *anon/publishable* key only. NEVER put the service_role key in the client.
SUPABASE_ANON_KEY=your-anon-public-key

# Android release signing (CI: store as GitHub Secrets)
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
